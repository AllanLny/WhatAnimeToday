# Template d'exemple pour les propriétés Spring Boot
# Copier ce fichier en `application.properties` et ajuster les valeurs locales.

# Nom de l'application
spring.application.name=wat-backend

# Port du serveur (ex: 8080)
server.port=8080

# APIs externes
kitsu.api.base-url=https://kitsu.io/api/edge
jikan.api.base-url=https://api.jikan.moe/v4

# TMDB (utilisé pour récupérer les fournisseurs de streaming)
tmdb.api.base-url=https://api.themoviedb.org/3
tmdb.api.key=YOUR_TMDB_API_KEY

# Cache
app.cache.default-ttl-hours=24

# Swagger/OpenAPI
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html


# -----------------------------------------------------------------------------
# Discord / OAuth configuration (placeholders — use environment variables)
# - `discord.client.id` and `discord.client.secret` are required for the OAuth code exchange
# - `discord.redirect.uri` must match the redirect URI registered in your Discord application
# - `app.frontend.url` is used to prefix relative redirect paths when redirecting back to the frontend
# Do NOT commit secrets; set them via environment variables in CI or on the host.
# Example (zsh):
#   export DISCORD_CLIENT_ID="your_app_client_id"
#   export DISCORD_CLIENT_SECRET="your_app_client_secret"
#   export DISCORD_REDIRECT_URI="https://your.frontend.example/api/auth/discord/callback"
#   export APP_FRONTEND_URL="http://localhost:5173"
# -----------------------------------------------------------------------------
discord.client.id=YOUR_CLIENT_ID
discord.client.secret=YOUR_SECRET
discord.redirect.uri=${DISCORD_REDIRECT_URI:http://YOUR_BACKEND_URL/api/auth/discord/callback}


# NOTE: NE PAS COMMITTER les secrets ou clés API. Utiliser les variables d'environnement
# ou un mécanisme sécurisé pour stocker des credentials.
