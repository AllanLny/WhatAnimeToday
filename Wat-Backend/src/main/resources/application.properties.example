# Template d'exemple pour les propriétés Spring Boot
# Copier ce fichier en `application.properties` et ajuster les valeurs locales.

# Nom de l'application
spring.application.name=wat-backend

# Port du serveur (ex: 8080)
server.port=8080

# APIs externes
kitsu.api.base-url=https://kitsu.io/api/edge
jikan.api.base-url=https://api.jikan.moe/v4

# TMDB (utilisé pour récupérer les fournisseurs de streaming)
tmdb.api.base-url=https://api.themoviedb.org/3
tmdb.api.key=YOUR_TMDB_API_KEY

# Cache
app.cache.default-ttl-hours=24

# Swagger/OpenAPI
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html

# NOTE: NE PAS COMMITTER les secrets ou clés API. Utiliser les variables d'environnement
# ou un mécanisme sécurisé pour stocker des credentials.
